## App Defaults
APP_NAME=JARVISv7
JARVIS_LANGUAGE=english

## Model Provider credential store
# Generated on the first credential save. Leave blank.
JARVIS_SECRET_STORE_KEY=

## Use Jarvis Local LLM Sidecar(runtimes/llama.cpp + models/llm/name)
USE_LOCAL_MODEL=true
LLM_MODEL_MODE=dev
LLM_MODEL_POLICY=auto
LLM_MODEL_ID=

# Use External OpenAI-compatible llama.cpp compatible API 
# Requires a running instance of the llama.cpp server outside of Jarvis
LLAMA_CPP_MANAGED=false
LLAMA_CPP_BASE_URL=http://127.0.0.1:8888/v1
LLAMA_CPP_MODEL_NAME=unsloth
LLAMA_CPP_CONTEXT_SIZE=32768

## Use Local Ollama Application
# Fallback or Dev
USE_OLLAMA=false
OLLAMA_MODEL=phi4-mini

## Optional Services
# Redis Cache (requires Docker)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# SearXNG Search (requires Docker)
USE_SEARXNG=false
SEARXNG_PORT=8910
# Duck-Duck-Go Search (has usage limits)
USE_DDGS=false
# Tavily Search (requires an API key)
USE_TAVILY=false
TAVILY_API_KEY=

## App Paths
